@@ -0,0 +1,116 @@
+/* Drum Silencer's editor (drumsilencer.tsx): a row of displays over a row
+   of control cards, laid out as the gate and dynamics editors are. */
+
+.ds-displays {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  min-width: 0;
+}
+
+/* A display column: its share of the row by flex-grow, never narrower than
+   its min-width (set inline, capped at the row's width for a phone). */
+.ds-col {
+  display: flex;
+  flex-direction: column;
+  flex-basis: 0;
+  height: 300px;
+  min-width: 0;
+}
+
+.ds-col > .pe-canvas {
+  flex: 1;
+}
+
+/* The meter bay: a fixed-width panel of three columns. */
+.ds-meters {
+  flex: 0 0 170px;
+  width: 170px;
+}
+
+.ds-well {
+  display: flex;
+  flex: 1;
+  padding: 8px;
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--r);
+  background: var(--surface-panel);
+  min-height: 0;
+}
+
+.ds-well > .pe-canvas {
+  flex: 1;
+}
+
+.ds-bare {
+  background: transparent;
+  border: 0;
+  border-radius: 0;
+}
+
+/* The passing notice along a display's bottom edge. */
+.ds-notice {
+  position: absolute;
+  left: 50%;
+  bottom: 40px;
+  transform: translateX(-50%);
+  max-width: calc(100% - 24px);
+  padding: 4px 8px;
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--r);
+  background: var(--surface-raised);
+  color: var(--text-secondary);
+  font-size: 10px;
+  text-align: center;
+  pointer-events: none;
+}
+
+.ds-stack {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  min-width: 0;
+}
+
+.ds-stack.hair {
+  gap: 2px;
+}
+
+/* A segmented choice is as wide as its labels, not its column. */
+.ds-stack > .segments {
+  align-self: flex-start;
+}
+
+.ds-hint {
+  max-width: 180px;
+  font-size: 10px;
+  color: var(--text-muted);
+}
+
+.ds-latency {
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--text-primary);
+}
+
+/* Segments split a track equally, as the native segmented track does. */
+.ds-track {
+  display: flex;
+}
+
+.ds-track button {
+  flex: 1 1 0;
+  justify-content: center;
+  padding: 0 10px;
+  white-space: nowrap;
+}
+
+@media (max-width: 640px) {
+  .ds-col {
+    height: 240px;
+  }
+
+  .ds-meters {
+    flex-grow: 1;
+  }
+}
diff --git a/apps/native/livestage/webui/src/editors/drumsilencer.tsx b/apps/native/livestage/webui/src/editors/drumsilencer.tsx
new file mode 100644
index 00000000..588f30f0
--- /dev/null
+++ b/apps/native/livestage/webui/src/editors/drumsilencer.tsx
@@ -0,0 +1,405 @@
+// Drum Silencer's editor, in the frame and visual language of the other
+// built-in editors (gate.tsx, dynamics.tsx).
+//
+// A row of displays over a row of control cards:
+// * Bands: per meter band (drumsilencer::BAND_EDGES_HZ) the whole input and
+//   the drums the network hears, on one frequency axis with the range the
+//   effect works in (drumsilencer::range_weight) shaded over it and drawn as
+//   a lane underneath;
+// * Meters: In, Drums and Out.
+//
+// The bands arrive in the standard level frame (MeterFrame::rack_slots):
+// rack position b's input level is band b's drums, its output level band b's
+// input. The Drums meter is those bands summed: the DSP's drums level is the
+// same sum, so this reads it exactly (with the bands' hold).
+//
+// LiveStage compensates no insert delay, so the editor says what this one
+// costs: the delay is fixed, on or off, at every setting.
+
+import type { CSSProperties, ReactNode } from 'react'
+import { Knob } from '../controls.tsx'
+import type { Editor, EditorComponent } from './kit.tsx'
+import { Card, DisplayTag, EditorShell, HERO_KNOB, KNOB, LiveCanvas, ParamChoice, Row } from './kit.tsx'
+import type { KnobSpec } from './knobspec.ts'
+import { bipolar, formatValue, fromKnob, knobRange, readout as kitReadout, spec, toKnob } from './knobspec.ts'
+import type { Live } from './live.ts'
+import { toDb } from './live.ts'
+import type { Ctx } from './paint.ts'
+import { alpha, area, colors, dashed, dbText, DENSE_CAPTION, freqFraction, label, line, rect, UI_XS } from './paint.ts'
+import './drumsilencer.css'
+
+/** drumsilencer::LOW_OFF_HZ / HIGH_OFF_HZ: a range edge here is off. */
+const LOW_OFF_HZ = 20
+const HIGH_OFF_HZ = 20000
+/** drumsilencer::EDGE_OCTAVES: how far past an edge the effect fades out. */
+const EDGE_OCTAVES = 0.5
+/** drumsilencer::BAND_EDGES_HZ, closed at both ends of the axis. */
+const BAND_EDGES = [20, 100, 300, 1000, 3000, 8000, 20000]
+const BANDS = BAND_EDGES.length - 1
+/** Mode in wire order (drumsilencer::Mode). */
+const SOLO = 1
+/** The level floor the bands and meters draw down to, dBFS. */
+const FLOOR_DB = -60
+/** Room for a display's tags above what it paints. */
+const TAG_ROOM = 26
+/** native plugin_kit::KNOB_PITCH: a knob cell and its gap. */
+const KNOB_PITCH = 62
+const FREQ_TICKS: [number, string][] = [
+  [20, '20'],
+  [50, '50'],
+  [100, '100'],
+  [200, '200'],
+  [500, '500'],
+  [1000, '1k'],
+  [2000, '2k'],
+  [5000, '5k'],
+  [10000, '10k'],
+  [20000, '20k'],
+]
+
+const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v))
+/** A min-width that never pushes past a phone's width. */
+const minWidth = (px: number): CSSProperties => ({ minWidth: `min(${px}px, 100%)` })
+
+const lowIsOff = (hz: number) => hz <= LOW_OFF_HZ + 0.5
+const highIsOff = (hz: number) => hz >= HIGH_OFF_HZ - 0.5
+
+/** drumsilencer::range_weight: how much of the effect applies at `hz`. */
+function rangeWeight(hz: number, lowHz: number, highHz: number): number {
+  let w = 1
+  if (!lowIsOff(lowHz)) w *= clamp(1 + Math.log2(Math.max(hz, 1e-3) / lowHz) / EDGE_OCTAVES, 0, 1)
+  if (!highIsOff(highHz)) w *= clamp(1 - Math.log2(Math.max(hz, 1e-3) / highHz) / EDGE_OCTAVES, 0, 1)
+  return w
+}
+
+/** The insert's delay in ms (Dsp::latency_samples: two hops less one, the
+ *  hop 128 samples times the rate's scale — 255 samples at 48 kHz). */
+function latencyMs(sampleRate: number): number {
+  const sr = Math.max(1, sampleRate)
+  let scale = clamp(Math.round(sr / 48000), 1, 4)
+  if (scale === 3) scale = 2
+  return ((256 * scale - 1) * 1000) / sr
+}
+
+interface Settings {
+  solo: boolean
+  lowHz: number
+  highHz: number
+  power: boolean
+}
+
+function settingsOf(e: Editor): Settings {
+  return {
+    solo: Math.round(e.value('mode')) === SOLO,
+    lowHz: e.value('lowHz'),
+    highHz: e.value('highHz'),
+    power: e.flag('power'),
+  }
+}
+
+/** Whether the range leaves anything for the effect to work on. */
+function rangeIsEmpty(s: Settings): boolean {
+  for (let i = 0; i <= 200; i++) {
+    if (rangeWeight(20 * Math.pow(1000, i / 200), s.lowHz, s.highHz) > 0.01) return false
+  }
+  return true
+}
+
+function edgeText(id: 'lowHz' | 'highHz', hz: number): string {
+  return (id === 'lowHz' ? lowIsOff(hz) : highIsOff(hz)) ? 'Off' : formatValue('hz', hz)
+}
+
+function rangeText(s: Settings): string {
+  const low = lowIsOff(s.lowHz)
+  const high = highIsOff(s.highHz)
+  if (low && high) return 'Full range'
+  if (high) return `Above ${formatValue('hz', s.lowHz)}`
+  if (low) return `Below ${formatValue('hz', s.highHz)}`
+  return `${formatValue('hz', s.lowHz)} – ${formatValue('hz', s.highHz)}`
+}
+
+/** The drums heard over every band: the bands' mean squares summed. */
+function drumsLevel(drumBands: number[]): number {
+  let ms = 0
+  for (let b = 0; b < BANDS; b++) ms += (drumBands[b] ?? 0) ** 2
+  return Math.sqrt(ms)
+}
+
+// ── The bands ───────────────────────────────────────────────────────────
+
+function paintBands(ctx: Ctx, w: number, h: number, live: Live, s: Settings, dim: boolean) {
+  const c = colors()
+  const GUTTER = 44
+  const LANE_H = 12
+  const LANE_GAP = 6
+  const TICKS_H = 16
+  const plotW = Math.max(1, w - GUTTER)
+  const laneY = h - TICKS_H - LANE_H
+  const plotTop = 18
+  const plotH = Math.max(1, laneY - LANE_GAP - plotTop)
+  const xAt = (hz: number) => freqFraction(hz) * plotW
+  const yAt = (db: number) => plotTop + clamp(db / FLOOR_DB, 0, 1) * plotH
+  const a = dim ? 0.45 : 1
+
+  for (const db of [0, -12, -24, -36, -48, -60]) {
+    const y = yAt(db)
+    rect(ctx, 0, y, plotW, 1, alpha(c.text, 0.06))
+    label(ctx, db.toFixed(0), DENSE_CAPTION, c.textFaint, plotW + 6, y - 6)
+  }
+  for (const [hz, text] of FREQ_TICKS) {
+    const x = xAt(hz)
+    rect(ctx, x, plotTop, 1, laneY + LANE_H - plotTop, alpha(c.text, 0.035))
+    const align = hz === 20 ? 'left' : hz === 20000 ? 'right' : 'center'
+    label(ctx, text, DENSE_CAPTION, c.textFaint, x, laneY + LANE_H + 3, align)
+  }
+
+  // Each band: the input behind, the drums heard in front.
+  const frame = live.frame
+  for (let b = 0; b < BANDS; b++) {
+    const left = xAt(BAND_EDGES[b])
+    const right = xAt(BAND_EDGES[b + 1])
+    if (b > 0) rect(ctx, left, plotTop, 1, plotH, alpha(c.text, 0.08))
+    if (!frame) continue
+    const inputDb = toDb(frame.slot_out_peak[b] ?? 0)
+    const drumsDb = toDb(frame.slot_in_peak[b] ?? 0)
+    const [x, bw] = [left + 3, Math.max(1, right - left - 6)]
+    const inputY = yAt(inputDb)
+    if (inputDb > FLOOR_DB) {
+      rect(ctx, x, inputY, bw, plotTop + plotH - inputY, alpha(c.textMuted, 0.22 * a))
+      rect(ctx, x, inputY, bw, 1.5, alpha(c.textMuted, 0.8 * a))
+    }
+    const inset = Math.min(bw * 0.2, 14)
+    const drumsY = yAt(drumsDb)
+    if (drumsDb > FLOOR_DB) {
+      rect(ctx, x + inset, drumsY, bw - 2 * inset, plotTop + plotH - drumsY, alpha(c.accent, 0.5 * a))
+      rect(ctx, x + inset, drumsY, bw - 2 * inset, 1.5, alpha(c.accentHover, a))
+    }
+    if (right - left > 40) {
+      const text = drumsDb > FLOOR_DB ? dbText(drumsDb) : '—'
+      label(ctx, text, DENSE_CAPTION, c.textSecondary, (left + right) * 0.5, Math.max(plotTop, Math.min(inputY, drumsY) - 14), 'center')
+    }
+  }
+
+  // The range on the same axis: what lies outside it is shaded over the
+  // bands, the weight itself is the lane, and each edge that is on a line.
+  const STEP = 2
+  const weights: [number, number][] = []
+  for (let x = 0; x <= plotW; x += STEP) {
+    const hz = 20 * Math.pow(1000, x / plotW)
+    const weight = rangeWeight(hz, s.lowHz, s.highHz)
+    weights.push([x, weight])
+    if (weight < 0.99) rect(ctx, x, plotTop, STEP, plotH, alpha(c.canvas, 0.6 * (1 - weight)))
+  }
+  rect(ctx, 0, laneY, plotW, LANE_H, c.meterBg)
+  const lane = weights.map(([x, weight]): [number, number] => [x, laneY + LANE_H - weight * LANE_H])
+  area(ctx, lane, laneY + LANE_H, alpha(c.accent, 0.4 * a))
+  line(ctx, lane, 1, alpha(c.accent, a))
+  label(ctx, 'Range', DENSE_CAPTION, c.textFaint, plotW + 6, laneY)
+  const edge = (hz: number, text: string, side: 'left' | 'right') => {
+    const x = xAt(hz)
+    dashed(ctx, [x, plotTop], [x, laneY + LANE_H], 1, alpha(c.accent, 0.85 * a))
+    label(ctx, text, DENSE_CAPTION, alpha(c.accent, a), side === 'left' ? x + 4 : x - 4, plotTop + plotH - 14, side)
+  }
+  if (!lowIsOff(s.lowHz)) edge(s.lowHz, `Low ${formatValue('hz', s.lowHz)}`, 'left')
+  if (!highIsOff(s.highHz)) edge(s.highHz, `High ${formatValue('hz', s.highHz)}`, 'right')
+
+  // The legend, under the tags.
+  const legend: [string, string][] = [
+    ['Input', alpha(c.textMuted, 0.8)],
+    ['Drums heard', c.accent],
+  ]
+  let lx = 8
+  for (const [text, color] of legend) {
+    rect(ctx, lx, 3, 8, 8, color, 2)
+    label(ctx, text, DENSE_CAPTION, c.textMuted, lx + 12, 1)
+    lx += 12 + ctx.measureText(text).width + 14
+  }
+  if (!frame) label(ctx, 'No signal', UI_XS, c.textMuted, plotW / 2, plotTop + plotH / 2 - 7, 'center')
+}
+
+// ── The meters ──────────────────────────────────────────────────────────
+
+function paintMeters(ctx: Ctx, w: number, h: number, live: Live, dim: boolean) {
+  const c = colors()
+  const CAPTION_H = 16
+  const READOUT_H = 18
+  const NOTE_H = 16
+  const BAR_W = 12
+  const frame = live.frame
+  const barTop = CAPTION_H
+  const barH = Math.max(1, h - CAPTION_H - READOUT_H - NOTE_H)
+  const unit = (level: number) => clamp((toDb(level) - FLOOR_DB) / -FLOOR_DB, 0, 1)
+  const columns: [string, number | null, number | null, string][] = [
+    ['In', frame?.in_rms ?? null, frame?.in_peak ?? null, c.textMuted],
+    ['Drums', frame ? drumsLevel(frame.slot_in_peak) : null, null, dim ? c.textMuted : c.accent],
+    ['Out', frame?.out_rms ?? null, frame?.out_peak ?? null, c.textMuted],
+  ]
+  const columnW = w / columns.length
+  columns.forEach(([caption, rms, peak, tone], i) => {
+    const centre = columnW * (i + 0.5)
+    label(ctx, caption, DENSE_CAPTION, c.textMuted, centre, 0, 'center')
+    const x = centre - BAR_W / 2
+    rect(ctx, x, barTop, BAR_W, barH, c.meterBg)
+    if (rms !== null) {
+      const top = barTop + (1 - unit(rms)) * barH
+      rect(ctx, x, top, BAR_W, barTop + barH - top, tone)
+    }
+    if (peak !== null && unit(peak) > 0) {
+      rect(ctx, x, barTop + (1 - unit(peak)) * barH, BAR_W, 1.5, peak >= 1 ? c.meterHigh : c.text)
+    }
+    const text = rms === null ? '—' : dbText(toDb(rms))
+    label(ctx, text, UI_XS, c.textSecondary, centre, barTop + barH + 3, 'center')
+  })
+  label(ctx, 'RMS · tick: peak', DENSE_CAPTION, c.textFaint, w / 2, h - NOTE_H + 3, 'center')
+}
+
+// ── The editor ──────────────────────────────────────────────────────────
+
+function Displays(props: { editor: Editor }) {
+  const e = props.editor
+  const live = e.live
+  const s = settingsOf(e)
+  const ms = latencyMs(e.sampleRate).toFixed(1)
+  const notice = !s.power
+    ? `Power off — audio passes unchanged, still ${ms} ms late`
+    : e.bypassed
+      ? `Bypassed — the insert is skipped, and its ${ms} ms delay with it`
+      : rangeIsEmpty(s)
+        ? s.solo
+          ? 'The range is empty — nothing is kept'
+          : 'The range is empty — nothing is taken out'
+        : null
+  return (
+    <div className="ds-displays">
+      <div className="ds-col" style={{ flexGrow: 4, ...minWidth(300) }}>
+        <LiveCanvas
+          draw={(ctx, w, h) => {
+            ctx.translate(0, TAG_ROOM)
+            paintBands(ctx, w, h - TAG_ROOM, live, s, e.bypassed)
+          }}
+        >
+          <DisplayTag>Bands</DisplayTag>
+          <DisplayTag right>{rangeText(s)}</DisplayTag>
+          {notice && <span className="ds-notice">{notice}</span>}
+        </LiveCanvas>
+      </div>
+      <div className="ds-col ds-meters">
+        <div className="ds-well">
+          <LiveCanvas className="ds-bare" draw={(ctx, w, h) => paintMeters(ctx, w, h, live, e.bypassed)} />
+        </div>
+      </div>
+    </div>
+  )
+}
+
+const KNOBS: Record<string, KnobSpec> = {
+  amount: spec('amount', 'Amount', 0, 100, 'linear', 'percent'),
+  lowHz: spec('lowHz', 'Low', LOW_OFF_HZ, 2000, 'log', 'hz'),
+  highHz: spec('highHz', 'High', 1000, HIGH_OFF_HZ, 'log', 'hz'),
+  outputDb: bipolar(spec('outputDb', 'Output', -24, 12, 'linear', 'db'), 0),
+}
+
+/** The knob for `id`, its range from the effect's descriptor. */
+function knobSpec(e: Editor, id: string): KnobSpec | null {
+  const range = e.effect.params.find((p) => p.id === id)
+  const s = KNOBS[id]
+  return range && s ? { ...s, min: range.min, max: range.max } : null
+}
+
+/** The range edges read "Off" at their end stops; the rest as the kit does. */
+function readout(s: KnobSpec, value: number): string {
+  return s.id === 'lowHz' || s.id === 'highHz' ? edgeText(s.id, value) : kitReadout(s, value)
+}
+
+/** kit's KitKnob, with the range edges' readout. */
+function DsKnob(props: { editor: Editor; id: string; size?: number }) {
+  const { editor } = props
+  const s = knobSpec(editor, props.id)
+  if (!s) return null
+  const [lo, hi] = knobRange(s)
+  return (
+    <div className="pe-knob">
+      <Knob
+        value={toKnob(s, editor.value(s.id))}
+        min={lo}
+        max={hi}
+        defaultValue={toKnob(s, editor.defaultOf(s.id))}
+        bipolar={s.bipolar}
+        size={props.size ?? KNOB}
+        label={`${s.label} (double-click: default)`}
+        caption={s.label}
+        format={(units) => readout(s, fromKnob(s, units))}
+        onChange={(units) => editor.set(s.id, fromKnob(s, units))}
+      />
+    </div>
+  )
+}
+
+function Controls(props: { editor: Editor }) {
+  const e = props.editor
+  const s = settingsOf(e)
+  const knob = (id: string, size = KNOB) => <DsKnob key={id} editor={e} id={id} size={size} />
+  const ms = latencyMs(e.sampleRate).toFixed(1)
+  const knobCard = (title: string, knobs: ReactNode[], hint?: string) => (
+    <Card key={title} title={title} grow={knobs.length} style={minWidth(knobs.length * KNOB_PITCH + 18)}>
+      <div className="ds-stack">
+        <div className="pe-knobs">{knobs}</div>
+        {hint && <span className="ds-hint">{hint}</span>}
+      </div>
+    </Card>
+  )
+  return (
+    <Row>
+      <Card title="MODE" grow={0} style={minWidth(210)}>
+        <div className="ds-stack">
+          <ParamChoice
+            editor={e}
+            id="mode"
+            options={[
+              [0, 'Remove'],
+              [SOLO, 'Drums Only'],
+            ]}
+            className="ds-track"
+          />
+          <span className="ds-hint">
+            {s.solo ? 'Keeps the drums the network hears, and only them' : 'Takes the drums the network hears out of the mix'}
+          </span>
+        </div>
+      </Card>
+      {knobCard('AMOUNT', [knob('amount', HERO_KNOB), knob('outputDb')])}
+      {knobCard(
+        'RANGE',
+        [knob('lowHz'), knob('highHz')],
+        s.solo ? 'Outside the range is silent' : 'Outside the range passes untouched',
+      )}
+      <Card title="LATENCY" grow={1} style={minWidth(170)}>
+        <div className="ds-stack hair">
+          <strong className="ds-latency">Adds {ms} ms</strong>
+          <span className="ds-hint">
+            Fixed, on or off. LiveStage does not delay the other strips to match: this strip plays {ms} ms behind them.
+          </span>
+        </div>
+      </Card>
+    </Row>
+  )
+}
+
+function DrumSilencerEditor(props: { editor: Editor }) {
+  const { editor } = props
+  const s = settingsOf(editor)
+  const ms = latencyMs(editor.sampleRate).toFixed(1)
+  const full = lowIsOff(s.lowHz) && highIsOff(s.highHz)
+  const subtitle = [s.solo ? 'Drums only' : 'Drum removal', full ? null : rangeText(s), `adds ${ms} ms`]
+    .filter(Boolean)
+    .join(' · ')
+  return (
+    <EditorShell editor={editor} title="Drum Silencer" subtitle={subtitle}>
+      <Displays editor={editor} />
+      <Controls editor={editor} />
+    </EditorShell>
+  )
+}
+
+export const editors: Record<string, EditorComponent> = {
+  drumsilencer: DrumSilencerEditor,
+}
