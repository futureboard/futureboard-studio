+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Frame `i` of a stereo source holds `(i, -i)`.
+    fn ramp(frames: usize) -> Vec<f32> {
+        (0..frames).flat_map(|i| [i as f32, -(i as f32)]).collect()
+    }
+
+    #[test]
+    fn the_pre_roll_is_the_source_just_before_the_range() {
+        let source = ramp(100);
+        let body = slice_frames(&source, 2, 40, 60);
+        let (input, lead) = with_pre_roll(&source, 2, 40, 10, &body);
+        assert_eq!(lead, 10);
+        assert_eq!(&input[..], &slice_frames(&source, 2, 30, 60)[..]);
+    }
+
+    #[test]
+    fn the_pre_roll_stops_at_the_start_of_the_file() {
+        let source = ramp(100);
+        let body = slice_frames(&source, 2, 4, 20);
+        let (input, lead) = with_pre_roll(&source, 2, 4, 10, &body);
+        assert_eq!(lead, 4);
+        assert_eq!(&input[..], &slice_frames(&source, 2, 0, 20)[..]);
+
+        let (input, lead) = with_pre_roll(&source, 2, 0, 10, &body);
+        assert_eq!(lead, 0);
+        assert!(matches!(input, std::borrow::Cow::Borrowed(_)));
+    }
+
+    /// End to end through the commit's own pieces: a mid-file range rendered
+    /// with its pre-roll is the matching stretch of one render of the whole
+    /// file from that pre-roll on, and splices back in at the same frames.
+    #[test]
+    fn a_drum_silencer_commit_renders_the_range_with_context() {
+        let sample_rate = 48_000u32;
+        let frames = 3 * sample_rate as usize;
+        let source: Vec<f32> = (0..frames)
+            .flat_map(|i| {
+                let value = (std::f32::consts::TAU * 330.0 * i as f32 / 48_000.0).sin() * 0.25;
+                [value, -value]
+            })
+            .collect();
+        let (start, end) = (2 * sample_rate as u64, 2 * sample_rate as u64 + 4_800);
+        let pre_roll = drum_silencer::pre_roll_frames(sample_rate) as u64;
+        let params = drumsilencer::default_params();
+
+        let region = slice_frames(&source, 2, start as i64, end as i64);
+        let (input, lead) = with_pre_roll(&source, 2, start, pre_roll, &region);
+        assert_eq!(lead as u64, pre_roll);
+        let processed = drum_silencer::render_interleaved(&input, 2, sample_rate, &params, lead);
+        assert_eq!(processed.len(), region.len());
+
+        let reference_input = slice_frames(&source, 2, (start - pre_roll) as i64, end as i64);
+        let reference =
+            drum_silencer::render_interleaved(&reference_input, 2, sample_rate, &params, 0);
+        assert_eq!(processed, reference[pre_roll as usize * 2..]);
+
+        let mut clip = source.clone();
+        replace_frame_range(&mut clip, 2, start as i64, &processed);
+        assert_eq!(clip[..start as usize * 2], source[..start as usize * 2]);
+        assert_eq!(clip[end as usize * 2..], source[end as usize * 2..]);
+    }
+}
