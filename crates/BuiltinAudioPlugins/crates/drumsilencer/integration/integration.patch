+/// (with whatever weights it ships) at `params` over a synthetic groove: a
+/// kick on every beat, a snare on two and four, eighth-note hats, over a
+/// bass note and a held chord. One frame per ~33 ms block, as the host
+/// publishes them; with the latency the DSP reports.
+fn drumsilencer_frames(
+    params: &drumsilencer::Params,
+) -> (
+    Arc<Vec<SpherePluginHost::audio_bridge::BuiltinMeterFrame>>,
+    u32,
+) {
+    use drumsilencer::StereoEffect;
+    use std::f32::consts::TAU;
+    const SR: f32 = 48_000.0;
+    const BLOCK: usize = 1_600;
+    let mut dsp = drumsilencer::Dsp::new(SR);
+    dsp.set_params(params.clone());
+    let mut seed = 0x2545_f491u32;
+    let mut noise = move || {
+        seed ^= seed << 13;
+        seed ^= seed >> 17;
+        seed ^= seed << 5;
+        seed as f32 / u32::MAX as f32 * 2.0 - 1.0
+    };
+    let mut last_noise = 0.0f32;
+    let mut frames = Vec::with_capacity(300);
+    for block in 0..300 {
+        for n in 0..BLOCK {
+            let t = (block * BLOCK + n) as f32 / SR;
+            let in_beat = t % 0.5;
+            let beat = (t / 0.5) as usize;
+            let in_eighth = t % 0.25;
+            let kick = 0.8
+                * (-in_beat / 0.12).exp()
+                * (TAU * (50.0 + 60.0 * (-in_beat / 0.03).exp()) * in_beat).sin();
+            let white = noise();
+            let snare = if beat % 2 == 1 {
+                0.35 * (-in_beat / 0.09).exp() * (white + 0.6 * (TAU * 190.0 * in_beat).sin())
+            } else {
+                0.0
+            };
+            let hat = 0.08 * (-in_eighth / 0.025).exp() * (white - last_noise);
+            last_noise = white;
+            let bass = 0.15 * (TAU * 55.0 * t).sin();
+            let chord = 0.05
+                * ((TAU * 220.0 * t).sin() + (TAU * 277.2 * t).sin() + (TAU * 329.6 * t).sin());
+            let x = kick + snare + hat + bass + chord;
+            dsp.process_stereo(x, x);
+        }
+        let f = dsp.meter_frame();
+        let (slot_in_peak, slot_out_peak) = f.rack_slots();
+        frames.push(SpherePluginHost::audio_bridge::BuiltinMeterFrame {
+            in_peak: f.in_peak,
+            in_rms: f.in_rms,
+            out_peak: f.out_peak,
+            out_rms: f.out_rms,
+            gain_reduction_db: 0.0,
+            in_clip: f.in_clip,
+            out_clip: f.out_clip,
+            slot_in_peak,
+            slot_out_peak,
+        });
+    }
+    (Arc::new(frames), dsp.latency_samples() as u32)
+}
+
+fn open_drumsilencer(
+    options: WindowOptions,
+    cx: &mut App,
+    insert: &'static str,
+    params: drumsilencer::Params,
+) -> Result<AnyWindowHandle> {
+    if let Ok(json) = drumsilencer::ipc::DrumSilencerState::new(params.clone()).to_json() {
+        seed("drumsilencer", insert, json);
+    }
+    let (frames, latency) = drumsilencer_frames(&params);
+    let source = frames.clone();
+    let tick = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let host_ops = BuiltinEditorHostOps {
+        meter_source: Some(Arc::new(move |_| {
+            let at = tick.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            source.get(at % source.len()).copied()
+        })),
+        host_status_source: Some(Arc::new(move |_| Some((48_000, 512, latency, 120.0)))),
+        ..preview_host_ops()
+    };
+    let handle = cx.open_window(options, move |_, cx| {
+        cx.new(|cx| {
+            let window = KitWindow::new(
+                DrumSilencerModel,
+                key(insert),
+                identity("Drum Silencer"),
+                host_ops,
+                no_close(),
+                cx,
+            );
+            {
+                let mut live = window.live().borrow_mut();
+                for frame in frames.iter() {
+                    live.show(*frame);
+                }
+                live.show_status(48_000, latency);
+            }
+            window
+        })
+    })?;
+    Ok(handle.into())
+}
+
+fn drumsilencer_preset(name: &str) -> drumsilencer::Params {
+    drumsilencer::factory_presets()
+        .into_iter()
+        .find(|preset| preset.name == name)
+        .map_or_else(drumsilencer::default_params, |preset| preset.params)
+}
+
+fn drumsilencer_scene(options: WindowOptions, cx: &mut App) -> Result<AnyWindowHandle> {
+    open_drumsilencer(
+        options,
+        cx,
+        "drumsilencer",
+        drumsilencer_preset("Keep Kick"),
+    )
+}
+
+fn drumsilencer_drums_only_scene(options: WindowOptions, cx: &mut App) -> Result<AnyWindowHandle> {
+    let params = drumsilencer::Params {
+        high_hz: 8_000.0,
+        ..drumsilencer_preset("Drums Only")
+    };
+    open_drumsilencer(options, cx, "drumsilencer-drums-only", params)
+}
+
+fn drumsilencer_bypassed_scene(options: WindowOptions, cx: &mut App) -> Result<AnyWindowHandle> {
+    let params = drumsilencer::Params {
+        power: false,
+        ..drumsilencer_preset("Quieter Drums")
+    };
+    open_drumsilencer(options, cx, "drumsilencer-bypassed", params)
+}
+
 fn band_preset(kind: BandKind, name: &str) -> crate::components::band_model::BandParams {
     crate::components::band_model::presets(kind)
         .iter()
