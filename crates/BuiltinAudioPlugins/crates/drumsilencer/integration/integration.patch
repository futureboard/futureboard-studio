+/// `body` preceded by up to `pre_roll` frames of `source` ending at absolute
+/// frame `start`, and how many frames that lead-in is. Without a lead-in the
+/// body is passed through uncopied.
+fn with_pre_roll<'a>(
+    source: &[f32],
+    channels: usize,
+    start: u64,
+    pre_roll: u64,
+    body: &'a [f32],
+) -> (std::borrow::Cow<'a, [f32]>, usize) {
+    let total_frames = (source.len() / channels.max(1)) as u64;
+    let start = start.min(total_frames);
+    let lead = pre_roll.min(start);
+    if lead == 0 {
+        return (std::borrow::Cow::Borrowed(body), 0);
+    }
+    let mut input = slice_frames(source, channels, (start - lead) as i64, start as i64);
+    input.extend_from_slice(body);
+    (std::borrow::Cow::Owned(input), lead as usize)
+}
