+    /// Drum Silencer's frame: the input per band rides the rack blocks'
+    /// output levels, the drums heard their input levels — none while it is
+    /// off. Its delay is the fixed 255 samples the editor's latency note
+    /// states, and it needs no stage default to get there.
+    #[test]
+    fn drumsilencer_reports_its_bands_on_the_rack_blocks() {
+        assert!(stage_defaults("drumsilencer").is_empty());
+        let Some(BuiltinFx::DrumSilencer(dsp)) = BuiltinFx::new("drumsilencer", 48_000) else {
+            panic!("drumsilencer builds");
+        };
+        assert_eq!(dsp.latency_samples(), 255);
+
+        let mut fx = BuiltinFx::new("drumsilencer", 48_000).unwrap();
+        fx.apply_wire_param(drumsilencer::ipc::POWER_INDEX, 0.0);
+        // 500 Hz: the 300 Hz–1 kHz band.
+        let tone = |n: usize| -> Vec<f32> {
+            (0..n)
+                .map(|i| (i as f32 * std::f32::consts::TAU * 500.0 / 48_000.0).sin() * 0.5)
+                .collect()
+        };
+        let mut left = tone(4_096);
+        let mut right = left.clone();
+        fx.process(&mut left, &mut right);
+        let off = fx.level_frame().expect("Drum Silencer meters itself");
+        assert_eq!(off.gain_reduction_db, 0.0);
+        assert!(off.in_peak > 0.4 && off.out_peak > 0.4);
+        assert!(
+            off.slot_in_peak.iter().all(|&d| d == 0.0),
+            "no drums while off"
+        );
+        let input = off.slot_out_peak;
+        let loudest = (0..drumsilencer::BANDS)
+            .max_by(|&a, &b| input[a].total_cmp(&input[b]))
+            .unwrap();
+        assert_eq!(loudest, 2, "{input:?}");
+        // RMS of a 0.5 sine, give or take the window's spread.
+        assert!((input[2] - 0.354).abs() < 0.05, "{input:?}");
+
+        fx.apply_wire_param(drumsilencer::ipc::POWER_INDEX, 1.0);
+        fx.process(&mut left, &mut right);
+        let on = fx.level_frame().unwrap();
+        assert!(on.slot_in_peak.iter().all(|d| d.is_finite() && *d >= 0.0));
+        assert!(on.slot_out_peak[2] > 0.3);
+    }
 }
