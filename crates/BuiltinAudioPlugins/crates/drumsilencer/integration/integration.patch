--- /dev/null
+++ b/crates/SphereUIComponents/src/components/audio_tools/drum_silencer.rs
@@ -0,0 +1,242 @@
+//! Drum Silencer as an offline Audio Repair processor.
+//!
+//! The built-in plug-in's DSP (`drumsilencer::Dsp`) is a streaming effect: a
+//! causal recurrent network masks each short-time spectrum, and the output
+//! trails the input by `latency_samples()`. Offline that delay is removed
+//! exactly — the input is followed by `latency` zero frames and the first
+//! `latency` output frames are dropped — so the render lines up with the source
+//! sample for sample and can be spliced back into the clip.
+//!
+//! The network warms up over its first half second, so a render that starts
+//! mid-file is given up to [`PRE_ROLL_SECONDS`] of the audio before it as
+//! context. That lead-in is processed and then discarded.
+//!
+//! Scanner/offline code: runs on the background executor only. Allocation is
+//! fine here; nothing in this file is on a realtime path.
+
+use drumsilencer::{Dsp, Params, StereoEffect};
+
+/// Audio before the processed range the network hears first, when the source
+/// has it.
+pub(super) const PRE_ROLL_SECONDS: f64 = 1.0;
+
+/// [`PRE_ROLL_SECONDS`] in frames at `sample_rate`.
+pub(super) fn pre_roll_frames(sample_rate: u32) -> usize {
+    (PRE_ROLL_SECONDS * sample_rate as f64).round() as usize
+}
+
+/// Render interleaved `samples` through Drum Silencer.
+///
+/// The first `lead_in` frames are context only: they are processed so the
+/// network's state is warm, and are not part of the result. The returned
+/// buffer holds the remaining frames, aligned sample-exactly with them.
+///
+/// Channels are processed in pairs (L/R share the plug-in's one stereo
+/// transform); a last odd channel — or a mono file — runs as `(x, x)` and
+/// keeps the left output.
+pub(super) fn render_interleaved(
+    samples: &[f32],
+    channels: usize,
+    sample_rate: u32,
+    params: &Params,
+    lead_in: usize,
+) -> Vec<f32> {
+    let channels = channels.max(1);
+    let frames = samples.len() / channels;
+    let lead_in = lead_in.min(frames);
+    let out_frames = frames - lead_in;
+    let mut out = vec![0.0; out_frames * channels];
+    if out_frames == 0 {
+        return out;
+    }
+    let mut first = 0;
+    while first < channels {
+        let pair = first + 1 < channels;
+        let mut dsp = Dsp::new(sample_rate.max(1) as f32);
+        dsp.set_params(params.clone());
+        let latency = dsp.latency_samples();
+        // Output frame `i` is input frame `i - latency`; the frames the
+        // result keeps are inputs `lead_in..frames`.
+        for i in 0..frames + latency {
+            let (left, right) = if i < frames {
+                let left = samples[i * channels + first];
+                let right = if pair {
+                    samples[i * channels + first + 1]
+                } else {
+                    left
+                };
+                (left, right)
+            } else {
+                (0.0, 0.0)
+            };
+            let (out_left, out_right) = dsp.process_stereo(left, right);
+            let Some(source) = i.checked_sub(latency) else {
+                continue;
+            };
+            let Some(k) = source.checked_sub(lead_in) else {
+                continue;
+            };
+            out[k * channels + first] = out_left;
+            if pair {
+                out[k * channels + first + 1] = out_right;
+            }
+        }
+        first += if pair { 2 } else { 1 };
+    }
+    out
+}
+
+/// How long the result fades in from, and back out to, the original at each
+/// end of the range.
+pub(super) const EDGE_SECONDS: f64 = 0.010;
+
+/// Crossfade `processed` into the clip: over the first [`EDGE_SECONDS`] it
+/// moves linearly from `original` to the render, and over the last back again,
+/// so the splice has no step where a drum was cut off mid-ring. `original` is
+/// the same frames before processing; the two are sample-aligned, so the fade
+/// cannot comb. A range shorter than two edges fades over half of it each way.
+pub(super) fn fade_edges(
+    processed: &mut [f32],
+    original: &[f32],
+    channels: usize,
+    sample_rate: u32,
+) {
+    let channels = channels.max(1);
+    debug_assert_eq!(processed.len(), original.len());
+    let frames = processed.len().min(original.len()) / channels;
+    let edge = ((EDGE_SECONDS * sample_rate as f64).round() as usize)
+        .min(frames / 2)
+        .max(1);
+    for i in 0..edge.min(frames) {
+        let w = (i as f32 + 0.5) / edge as f32;
+        for frame in [i, frames - 1 - i] {
+            for c in 0..channels {
+                let k = frame * channels + c;
+                processed[k] = original[k] + (processed[k] - original[k]) * w;
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_edges_fade_from_and_back_to_the_original() {
+        let channels = 2;
+        let frames = 4_800;
+        let original = vec![1.0f32; frames * channels];
+        let mut processed = vec![0.0f32; frames * channels];
+        fade_edges(&mut processed, &original, channels, SR);
+        let edge = (EDGE_SECONDS * SR as f64) as usize;
+        // Close to the original at both ends, the render in the middle.
+        assert!(processed[0] > 0.99 && processed[(frames - 1) * channels + 1] > 0.99);
+        assert_eq!(processed[edge * channels], 0.0);
+        assert_eq!(processed[(frames / 2) * channels], 0.0);
+        // Halfway through the fade, halfway between.
+        assert!((processed[(edge / 2) * channels] - 0.5).abs() < 0.01);
+        // Monotone: no step anywhere in the fade.
+        for i in 1..edge {
+            assert!(processed[i * channels] <= processed[(i - 1) * channels]);
+        }
+        // A range too short for two edges still meets in the middle cleanly.
+        let mut short = vec![0.0f32; 10 * channels];
+        fade_edges(&mut short, &vec![1.0; 10 * channels], channels, SR);
+        assert!(short
+            .iter()
+            .all(|v| v.is_finite() && (0.0..=1.0).contains(v)));
+    }
+
+    const SR: u32 = 48_000;
+
+    fn noise(frames: usize, channels: usize, seed: u32) -> Vec<f32> {
+        let mut s = seed.wrapping_mul(747_796_405).wrapping_add(1);
+        (0..frames * channels)
+            .map(|_| {
+                s ^= s << 13;
+                s ^= s >> 17;
+                s ^= s << 5;
+                ((s as f32 / u32::MAX as f32) * 2.0 - 1.0) * 0.4
+            })
+            .collect()
+    }
+
+    fn worst_error(a: &[f32], b: &[f32]) -> f32 {
+        assert_eq!(a.len(), b.len());
+        a.iter()
+            .zip(b)
+            .fold(0.0f32, |worst, (x, y)| worst.max((x - y).abs()))
+    }
+
+    fn bypassed() -> Params {
+        Params {
+            power: false,
+            ..drumsilencer::default_params()
+        }
+    }
+
+    fn no_amount() -> Params {
+        Params {
+            amount: 0.0,
+            ..drumsilencer::default_params()
+        }
+    }
+
+    /// With the effect off — bypassed, or at 0 % — the offline render is the
+    /// input itself: the plug-in's delay is gone, not just shortened.
+    #[test]
+    fn a_transparent_render_equals_the_input_sample_for_sample() {
+        for channels in [1, 2, 3, 4] {
+            let input = noise(12_000, channels, channels as u32);
+            for params in [bypassed(), no_amount()] {
+                let out = render_interleaved(&input, channels, SR, &params, 0);
+                let err = worst_error(&input, &out);
+                assert!(err < 1.0e-5, "{channels} ch, power {}: {err}", params.power);
+            }
+        }
+    }
+
+    #[test]
+    fn the_latency_is_removed_at_high_rates_too() {
+        for rate in [44_100, 96_000, 192_000] {
+            let input = noise(rate as usize / 8, 2, 7);
+            let out = render_interleaved(&input, 2, rate, &bypassed(), 0);
+            assert!(worst_error(&input, &out) < 1.0e-5, "{rate}");
+        }
+    }
+
+    /// The lead-in is rendered for context and dropped: what comes back is the
+    /// selection only, and it is exactly the tail of rendering the lead-in and
+    /// the selection as one stream.
+    #[test]
+    fn the_pre_roll_is_processed_and_discarded() {
+        let lead_in = pre_roll_frames(SR) / 4;
+        let selection = 6_000;
+        let input = noise(lead_in + selection, 2, 11);
+        let params = drumsilencer::default_params();
+
+        let whole = render_interleaved(&input, 2, SR, &params, 0);
+        let out = render_interleaved(&input, 2, SR, &params, lead_in);
+        assert_eq!(out.len(), selection * 2);
+        assert_eq!(out, whole[lead_in * 2..]);
+
+        // Transparent settings still give back the selection itself, so the
+        // lead-in never leaks into the result or shifts it.
+        let out = render_interleaved(&input, 2, SR, &no_amount(), lead_in);
+        assert!(worst_error(&input[lead_in * 2..], &out) < 1.0e-5);
+    }
+
+    #[test]
+    fn a_lead_in_longer_than_the_input_renders_nothing() {
+        let input = noise(100, 2, 3);
+        assert!(render_interleaved(&input, 2, SR, &bypassed(), 500).is_empty());
+        assert!(render_interleaved(&[], 2, SR, &bypassed(), 0).is_empty());
+    }
+
+    #[test]
+    fn the_pre_roll_is_one_second() {
+        assert_eq!(pre_roll_frames(48_000), 48_000);
+        assert_eq!(pre_roll_frames(44_100), 44_100);
+    }
+}
diff --git a/crates/SphereUIComponents/src/components/drum_silencer_model.rs b/crates/SphereUIComponents/src/components/drum_silencer_model.rs
new file mode 100644
index 00000000..a93a09f2
--- /dev/null
+++ b/crates/SphereUIComponents/src/components/drum_silencer_model.rs
@@ -0,0 +1,254 @@
+//! What Drum Silencer's native editor edits: its params, their wire table,
+//! presets, knobs, and the words and levels the editor shows.
+//!
+//! No GPUI here. Every value goes back to the plug-in as wire edits the DSP
+//! crate's own `ipc` table computes and clamps, so an edit lands in the
+//! editor's copy exactly as it lands in Studio's state mirror and in the host.
+
+use std::sync::{Arc, OnceLock};
+
+use crate::components::fx_model::{format_value, spec, KnobSpec, Taper, Unit};
+use crate::components::plugin_kit::{bank, KitPreset};
+
+pub use drumsilencer::Params as SilencerParams;
+
+/// The bands the DSP meters, low to high, by name.
+pub const BAND_NAMES: [&str; drumsilencer::BANDS] =
+    ["Sub", "Low", "Low Mid", "Mid", "High Mid", "High"];
+
+/// Every band's edges, `BANDS + 1` of them: the DSP's inner edges between
+/// the ends of the display's axis.
+pub fn band_edges() -> [f32; drumsilencer::BANDS + 1] {
+    let mut edges = [drumsilencer::LOW_OFF_HZ; drumsilencer::BANDS + 1];
+    edges[1..drumsilencer::BANDS].copy_from_slice(&drumsilencer::BAND_EDGES_HZ);
+    edges[drumsilencer::BANDS] = drumsilencer::HIGH_OFF_HZ;
+    edges
+}
+
+/// Every param as `(wire index, value)`, in wire order.
+pub fn wire_values(params: &SilencerParams) -> Vec<(u32, f32)> {
+    drumsilencer::ipc::ui_values(params)
+        .into_iter()
+        .filter_map(|(id, value)| drumsilencer::ui_param_index(id).map(|index| (index, value)))
+        .collect()
+}
+
+/// Applies one edit by id the way the DSP will.
+pub fn with(params: &SilencerParams, id: &str, value: f32) -> SilencerParams {
+    let mut next = params.clone();
+    drumsilencer::ipc::apply_ui_param(&mut next, id, value);
+    next
+}
+
+pub fn value(params: &SilencerParams, id: &str) -> f32 {
+    drumsilencer::ipc::ui_values(params)
+        .into_iter()
+        .find(|(candidate, _)| *candidate == id)
+        .map_or(0.0, |(_, value)| value)
+}
+
+/// The factory bank, `Default` first.
+pub fn presets() -> Arc<Vec<KitPreset<SilencerParams>>> {
+    static BANK: OnceLock<Arc<Vec<KitPreset<SilencerParams>>>> = OnceLock::new();
+    BANK.get_or_init(|| bank(drumsilencer::factory_presets(), |p| (p.name, p.params)))
+        .clone()
+}
+
+/// `preset` as it would play here: power stays as it is.
+pub fn preset_applied(current: &SilencerParams, preset: &SilencerParams) -> SilencerParams {
+    SilencerParams {
+        power: current.power,
+        ..preset.clone()
+    }
+}
+
+/// The ids the knobs cover, in the order the editor lays them out.
+pub const KNOB_IDS: [&str; 4] = ["amount", "lowHz", "highHz", "outputDb"];
+
+/// The knob table. Ranges come from the DSP crate's descriptor, so a range
+/// change there reaches the editor without a second edit here.
+pub fn knob(id: &str) -> Option<KnobSpec> {
+    let descriptor = drumsilencer::descriptor();
+    let range = descriptor.params.iter().find(|p| p.id == id)?;
+    let (label, taper, unit) = match id {
+        "amount" => ("Amount", Taper::Linear, Unit::Percent),
+        "lowHz" => ("Low", Taper::Log, Unit::CutHz(drumsilencer::LOW_OFF_HZ)),
+        "highHz" => ("High", Taper::Log, Unit::Hz),
+        "outputDb" => ("Output", Taper::Linear, Unit::Db),
+        _ => return None,
+    };
+    let mut knob = spec(range.id, label, range.min, range.max, taper, unit);
+    // Output trims around unity.
+    knob.bipolar = id == "outputDb";
+    Some(knob)
+}
+
+/// Whether the range's low edge is off.
+pub fn low_off(hz: f32) -> bool {
+    hz <= drumsilencer::LOW_OFF_HZ + 0.5
+}
+
+/// Whether the range's high edge is off.
+pub fn high_off(hz: f32) -> bool {
+    hz >= drumsilencer::HIGH_OFF_HZ - 0.5
+}
+
+/// A knob's readout: an edge at its end stop is off, not 20 Hz or 20 kHz.
+pub fn readout(id: &str, value: f32) -> String {
+    match id {
+        "lowHz" if low_off(value) => "Off".to_string(),
+        "highHz" if high_off(value) => "Off".to_string(),
+        _ => knob(id).map_or_else(String::new, |k| format_value(k.unit, value)),
+    }
+}
+
+pub fn mode_labels() -> &'static [&'static str] {
+    &["Remove", "Drums Only"]
+}
+
+pub fn mode_hint(params: &SilencerParams) -> &'static str {
+    match params.mode {
+        drumsilencer::Mode::Remove => "Takes Amount of the drums out of the mix",
+        drumsilencer::Mode::Solo => "Keeps the drums, takes Amount of the rest out",
+    }
+}
+
+/// What happens outside the range, in the mode's own terms.
+pub fn range_hint(params: &SilencerParams) -> &'static str {
+    match params.mode {
+        drumsilencer::Mode::Remove => "Outside the range the mix passes untouched",
+        drumsilencer::Mode::Solo => "Outside the range is taken out with the rest",
+    }
+}
+
+/// The range the effect applies over, in words.
+pub fn range_text(params: &SilencerParams) -> String {
+    let hz = |value: f32| format_value(Unit::Hz, value);
+    match (low_off(params.low_hz), high_off(params.high_hz)) {
+        (true, true) => "Whole spectrum".to_string(),
+        (false, true) => format!("Above {}", hz(params.low_hz)),
+        (true, false) => format!("Below {}", hz(params.high_hz)),
+        (false, false) => format!("{} – {}", hz(params.low_hz), hz(params.high_hz)),
+    }
+}
+
+/// The drums heard, as one level, from the per-band levels the host
+/// publishes: their root-sum-square. The bands split the spectrum, so this
+/// is the DSP's `drums_rms`, with the bands' fall.
+pub fn drums_level(bands: &[f32]) -> f32 {
+    bands.iter().map(|level| level * level).sum::<f32>().sqrt()
+}
+
+/// A latency as the editor shows it.
+pub fn latency_text(ms: Option<f32>) -> String {
+    match ms {
+        None => "—".to_string(),
+        Some(ms) if ms < 0.05 => "0 ms".to_string(),
+        Some(ms) => format!("{ms:.1} ms"),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn same(a: &SilencerParams, b: &SilencerParams) -> bool {
+        let theirs = wire_values(b);
+        wire_values(a).iter().all(|(index, value)| {
+            theirs
+                .iter()
+                .find(|(i, _)| i == index)
+                .is_some_and(|(_, other)| (value - other).abs() <= 0.002 * value.abs().max(1.0))
+        })
+    }
+
+    /// Replaying a diff through the DSP's own wire table lands on the target —
+    /// the same path Studio's mirror and the host take.
+    #[test]
+    fn every_preset_lands_exactly_from_every_other() {
+        let bank = presets();
+        assert_eq!(bank[0].name, "Default");
+        assert!(bank.iter().any(|preset| preset.name == "Drums Only"));
+        for from in bank.iter() {
+            for to in bank.iter() {
+                let before = wire_values(&from.params);
+                let mut landed = from.params.clone();
+                for (index, value) in wire_values(&to.params) {
+                    if before.iter().any(|(i, v)| *i == index && *v == value) {
+                        continue;
+                    }
+                    landed = with(&landed, drumsilencer::ui_param_id(index).unwrap(), value);
+                }
+                assert!(same(&landed, &to.params), "{} → {}", from.name, to.name);
+            }
+        }
+    }
+
+    #[test]
+    fn a_preset_keeps_power() {
+        let current = with(&drumsilencer::default_params(), "power", 0.0);
+        for preset in presets().iter() {
+            assert!(!preset_applied(&current, &preset.params).power);
+        }
+    }
+
+    #[test]
+    fn every_knob_round_trips_through_its_taper() {
+        let defaults = drumsilencer::default_params();
+        for id in KNOB_IDS {
+            let knob = knob(id).unwrap_or_else(|| panic!("no knob for {id}"));
+            let default = value(&defaults, id);
+            let back = knob.from_knob(knob.to_knob(default));
+            assert!(
+                (back - default).abs() <= 0.011 * default.abs().max(1.0),
+                "{id}: {default} came back {back}"
+            );
+        }
+        // The end stops are reachable, and they are the off values.
+        let low = knob("lowHz").unwrap();
+        assert_eq!(low.from_knob(0.0), drumsilencer::LOW_OFF_HZ);
+        let high = knob("highHz").unwrap();
+        assert_eq!(high.from_knob(1.0), drumsilencer::HIGH_OFF_HZ);
+        assert!(knob("outputDb").unwrap().bipolar);
+    }
+
+    #[test]
+    fn readouts_say_off_at_the_off_values() {
+        assert_eq!(readout("lowHz", 20.0), "Off");
+        assert_eq!(readout("lowHz", 150.0), "150 Hz");
+        assert_eq!(readout("highHz", 20_000.0), "Off");
+        assert_eq!(readout("highHz", 8_000.0), "8.0 kHz");
+        assert_eq!(readout("amount", 60.0), "60 %");
+        assert_eq!(readout("outputDb", 0.0), "0.0 dB");
+    }
+
+    #[test]
+    fn the_range_reads_in_words() {
+        let params = drumsilencer::default_params();
+        assert_eq!(range_text(&params), "Whole spectrum");
+        let kick = with(&params, "lowHz", 150.0);
+        assert_eq!(range_text(&kick), "Above 150 Hz");
+        let both = with(&kick, "highHz", 8_000.0);
+        assert_eq!(range_text(&both), "150 Hz – 8.0 kHz");
+        let top = with(&params, "highHz", 4_000.0);
+        assert_eq!(range_text(&top), "Below 4.0 kHz");
+    }
+
+    #[test]
+    fn the_bands_span_the_axis_and_sum_to_the_drums_level() {
+        let edges = band_edges();
+        assert_eq!(edges[0], drumsilencer::LOW_OFF_HZ);
+        assert_eq!(edges[1], 100.0);
+        assert_eq!(edges[drumsilencer::BANDS], drumsilencer::HIGH_OFF_HZ);
+        assert!(edges.windows(2).all(|pair| pair[0] < pair[1]));
+        assert!((drums_level(&[0.3, 0.4, 0.0, 0.0, 0.0, 0.0]) - 0.5).abs() < 1.0e-6);
+        assert_eq!(drums_level(&[0.0; 6]), 0.0);
+    }
+
+    #[test]
+    fn latency_reads_in_milliseconds() {
+        assert_eq!(latency_text(None), "—");
+        assert_eq!(latency_text(Some(255.0 * 1_000.0 / 48_000.0)), "5.3 ms");
+        assert_eq!(latency_text(Some(0.0)), "0 ms");
+    }
+}
diff --git a/crates/SphereUIComponents/src/components/drum_silencer_panel.rs b/crates/SphereUIComponents/src/components/drum_silencer_panel.rs
new file mode 100644
index 00000000..7a8fb0d8
--- /dev/null
+++ b/crates/SphereUIComponents/src/components/drum_silencer_panel.rs
@@ -0,0 +1,708 @@
+//! Drum Silencer's native editor, on the plug-in kit.
+//!
+//! One display and a meter bay over a row of control cards:
+//!
+//! * **Bands** — the six bands the DSP meters, on one frequency axis: each
+//!   band's whole input as a muted column, the drums the network hears in it
+//!   as a narrower accent column inside, and along the bottom a lane showing
+//!   how much of the effect applies at each frequency
+//!   ([`drumsilencer::range_weight`], what the DSP itself weighs its bins
+//!   by), with the range's edges marked;
+//! * **Meters** — In, Drums and Out, and the latency the host reports for
+//!   the insert.
+//!
+//! The panel paints only what follows the params — the axis, the band edges,
+//! the range; the levels are painted by the window's overlay into the bounds
+//! recorded here. Telemetry comes through the standard level frame: the drums
+//! heard per band ride the rack positions' input levels and the whole input
+//! per band their output levels (`drumsilencer::MeterFrame::rack_slots`).
+
+use std::sync::Arc;
+
+use gpui::{
+    canvas, div, fill, px, AnyElement, App, Bounds, IntoElement, ParentElement, Pixels, Styled,
+    Window,
+};
+
+use crate::components::band_panel::{band_plot, x_of, FREQ_TICKS};
+use crate::components::builtin_plugin_editor_window::{BuiltinEditorHostOps, PluginInstanceKey};
+use crate::components::drum_silencer_model::{
+    self, band_edges, drums_level, high_off, latency_text, low_off, mode_hint, mode_labels,
+    preset_applied, presets, range_hint, range_text, readout, SilencerParams, BAND_NAMES,
+};
+use crate::components::eq_graph::{freq_at_fraction, paint_area, paint_line};
+use crate::components::fx_model::{format_value, KnobSpec, Unit};
+use crate::components::knob::knob_with_default;
+use crate::components::native_plugin_shell::ShellIdentity;
+use crate::components::plugin_kit::{
+    card, choice, display_frame, header, hint, knob_for, open_kit_editor, Cx, KitEditor, KitModel,
+    KitPreset, KitWindow, LiveBounds, LiveSlot, HERO_KNOB, KNOB, KNOB_PITCH,
+};
+use crate::components::plugin_live::{dashed, frame_of, label, Align, Live};
+use crate::components::quick_sampler_panel::{knob_cell, rect};
+use crate::theme::{space, typography, Colors};
+
+/// The bottom of every level axis the editor draws, in dBFS.
+const FLOOR_DB: f32 = -60.0;
+/// The range lane along the bottom of the band display, and the gap above
+/// it the edges' tags sit in, clear of the columns.
+const LANE_H: f32 = 12.0;
+const LANE_GAP: f32 = 16.0;
+/// Columns the range lane and wash are sampled in.
+const RANGE_STEPS: usize = 160;
+
+/// Drum Silencer as a [`KitModel`]: one plug-in, so a unit type.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DrumSilencerModel;
+
+/// What the overlay paints from.
+pub struct SilencerLiveView {
+    params: SilencerParams,
+}
+
+impl KitModel for DrumSilencerModel {
+    type Params = SilencerParams;
+    type Ui = ();
+    type LiveView = SilencerLiveView;
+
+    fn title(self) -> &'static str {
+        "Drum Silencer"
+    }
+
+    fn subtitle(self, params: &SilencerParams) -> String {
+        match params.mode {
+            drumsilencer::Mode::Remove => "Removes the drums",
+            drumsilencer::Mode::Solo => "Keeps only the drums",
+        }
+        .to_string()
+    }
+
+    fn key(self) -> &'static str {
+        "drumsilencer"
+    }
+
+    fn defaults(self) -> SilencerParams {
+        drumsilencer::default_params()
+    }
+
+    fn from_mirror(self, insert_id: &str) -> Option<SilencerParams> {
+        crate::components::builtin_plugin_editor::builtin_drumsilencer_params(insert_id)
+    }
+
+    fn wire_values(self, params: &SilencerParams) -> Vec<(u32, f32)> {
+        drum_silencer_model::wire_values(params)
+    }
+
+    fn with(self, params: &SilencerParams, id: &str, value: f32) -> SilencerParams {
+        drum_silencer_model::with(params, id, value)
+    }
+
+    fn value(self, params: &SilencerParams, id: &str) -> f32 {
+        drum_silencer_model::value(params, id)
+    }
+
+    fn presets(self) -> Arc<Vec<KitPreset<SilencerParams>>> {
+        presets()
+    }
+
+    fn preset_applied(self, current: &SilencerParams, preset: &SilencerParams) -> SilencerParams {
+        preset_applied(current, preset)
+    }
+
+    fn knob(self, id: &str) -> Option<KnobSpec> {
+        drum_silencer_model::knob(id)
+    }
+
+    fn panel(editor: &KitEditor<Self>, cx: &mut Cx<Self>) -> AnyElement {
+        silencer_panel(editor, cx)
+    }
+
+    fn live_view(editor: &KitEditor<Self>) -> SilencerLiveView {
+        SilencerLiveView {
+            params: editor.params.clone(),
+        }
+    }
+
+    fn paint_live(
+        view: &SilencerLiveView,
+        live: &mut Live,
+        bounds: &LiveBounds,
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        let bypassed = !view.params.power;
+        if let Some(b) = bounds.get(LiveSlot::Bands) {
+            paint_band_levels(window, cx, b, live, bypassed);
+        }
+        if let Some(b) = bounds.get(LiveSlot::Meters) {
+            paint_silencer_meters(window, cx, b, live);
+        }
+    }
+
+    fn window_size(self) -> (f32, f32) {
+        (1_000.0, 640.0)
+    }
+
+    fn min_size(self) -> (f32, f32) {
+        (860.0, 560.0)
+    }
+}
+
+pub type DrumSilencerEditorWindow = KitWindow<DrumSilencerModel>;
+
+/// Opens with a track's Drum Silencer insert.
+pub fn open_drumsilencer_editor(
+    owner_bounds: Option<Bounds<Pixels>>,
+    key: PluginInstanceKey,
+    identity: ShellIdentity,
+    host_ops: BuiltinEditorHostOps,
+    on_close: Arc<dyn Fn(&mut Window, &mut App)>,
+    cx: &mut App,
+) -> Result<gpui::WindowHandle<DrumSilencerEditorWindow>, String> {
+    open_kit_editor(
+        DrumSilencerModel,
+        owner_bounds,
+        key,
+        identity,
+        host_ops,
+        on_close,
+        cx,
+    )
+}
+
+// ── The panel ───────────────────────────────────────────────────────────────
+
+fn silencer_panel(e: &KitEditor<DrumSilencerModel>, cx: &mut Cx<DrumSilencerModel>) -> AnyElement {
+    div()
+        .flex()
+        .flex_col()
+        .size_full()
+        .bg(Colors::surface_window())
+        .child(header(e, cx))
+        .child(
+            div()
+                .flex()
+                .flex_col()
+                .flex_1()
+                .min_h(px(0.0))
+                .p(px(space::LOOSE))
+                .gap(px(space::BASE))
+                .child(displays(e))
+                .child(controls(e, cx)),
+        )
+        .into_any_element()
+}
+
+/// The notice over the band display: a passing word, or what bypass does
+/// here — the transform keeps running at unit gain, so the delay stays.
+fn notice(e: &KitEditor<DrumSilencerModel>) -> Option<String> {
+    e.notice().map(str::to_string).or_else(|| {
+        (!e.power())
+            .then(|| "Bypassed — audio passes through untouched, at the same latency".to_string())
+    })
+}
+
+fn displays(e: &KitEditor<DrumSilencerModel>) -> AnyElement {
+    let bypassed = !e.power();
+    let params = e.params.clone();
+    let range = canvas(
+        |_, _, _| (),
+        move |bounds, _, window, cx| paint_band_display(window, cx, bounds, &params, bypassed),
+    )
+    .absolute()
+    .size_full();
+    let bands = div().flex().flex_col().flex_1().min_w(px(360.0)).child(
+        display_frame(
+            "BANDS",
+            Some(format!("Range: {}", range_text(&e.params))),
+            notice(e),
+            div()
+                .relative()
+                .size_full()
+                .child(range)
+                .child(e.live_bounds.slot(LiveSlot::Bands).absolute().size_full()),
+        )
+        .flex_1(),
+    );
+    let meters = div()
+        .flex()
+        .flex_col()
+        .w(px(METER_BAY_W))
+        .flex_shrink_0()
+        .child(
+            div()
+                .flex_1()
+                .p(px(space::BASE))
+                .border(px(1.0))
+                .border_color(Colors::border_subtle())
+                .bg(Colors::surface_panel())
+                .child(e.live_bounds.slot(LiveSlot::Meters).size_full()),
+        );
+
+    div()
+        .flex()
+        .flex_row()
+        .flex_1()
+        .min_h(px(220.0))
+        .gap(px(space::BASE))
+        .opacity(if bypassed { 0.8 } else { 1.0 })
+        .child(bands)
+        .child(meters)
+        .into_any_element()
+}
+
+/// The knob for `id`, with the plug-in's own readout ("Off" at an edge's
+/// end stop).
+fn silencer_knob(
+    e: &KitEditor<DrumSilencerModel>,
+    cx: &mut Cx<DrumSilencerModel>,
+    id: &'static str,
+    size: f32,
+) -> AnyElement {
+    let Some(spec) = drum_silencer_model::knob(id) else {
+        return div().into_any_element();
+    };
+    let value = e.value(id);
+    let default = drum_silencer_model::value(&drumsilencer::default_params(), id);
+    let (min, max) = spec.knob_range();
+    let control = knob_with_default(
+        format!("drumsilencer-{id}"),
+        spec.to_knob(value),
+        min,
+        max,
+        size,
+        Colors::accent_primary(),
+        spec.to_knob(default),
+        e.knob_cb(cx, spec),
+    );
+    knob_cell(spec.label, readout(id, value), control)
+}
+
+fn controls(e: &KitEditor<DrumSilencerModel>, cx: &mut Cx<DrumSilencerModel>) -> AnyElement {
+    let mode = choice(
+        e,
+        cx,
+        "drumsilencer-mode",
+        mode_labels(),
+        Some(e.params.mode.to_wire() as usize),
+        |this, index, cx| this.set_value("mode", index as f32, cx),
+    );
+    let mode_card = card(
+        "MODE",
+        0.0,
+        MODE_CARD_W,
+        div()
+            .flex()
+            .flex_col()
+            .gap(px(space::SNUG))
+            .child(mode)
+            .child(hint(mode_hint(&e.params))),
+    );
+    let amount = card(
+        "AMOUNT",
+        1.0,
+        KNOB_PITCH + 2.0 * space::BASE + 2.0,
+        silencer_knob(e, cx, "amount", HERO_KNOB),
+    );
+    let range = card(
+        "RANGE",
+        2.0,
+        2.0 * KNOB_PITCH + RANGE_HINT_W + space::LOOSE + 2.0 * space::BASE + 2.0,
+        div()
+            .flex()
+            .flex_row()
+            .items_start()
+            .gap(px(space::LOOSE))
+            .child(silencer_knob(e, cx, "lowHz", KNOB))
+            .child(silencer_knob(e, cx, "highHz", KNOB))
+            .child(
+                div()
+                    .w(px(RANGE_HINT_W))
+                    .pt(px(space::TIGHT))
+                    .child(hint(range_hint(&e.params))),
+            ),
+    );
+    let output = card(
+        "OUTPUT",
+        1.0,
+        KNOB_PITCH + 2.0 * space::BASE + 2.0,
+        knob_for(e, cx, "outputDb", KNOB, None),
+    );
+
+    div()
+        .flex()
+        .flex_row()
+        .flex_wrap()
+        .flex_shrink_0()
+        .gap(px(space::BASE))
+        .child(mode_card)
+        .child(amount)
+        .child(range)
+        .child(output)
+        .into_any_element()
+}
+
+/// The mode card's width: room for "Drums Only" on its segment.
+const MODE_CARD_W: f32 = 224.0;
+/// The range card's column of explanation.
+const RANGE_HINT_W: f32 = 130.0;
+/// The meter bay's width: three columns.
+const METER_BAY_W: f32 = 180.0;
+
+// ── The band display ────────────────────────────────────────────────────────
+
+/// The band display's two rectangles, `(x0, y0, w, h)`, within its slot: the
+/// levels above, the range lane below. The panel and the overlay both place
+/// by these, so the columns sit on the axis the panel drew.
+fn band_geometry(bounds: Bounds<Pixels>) -> ((f32, f32, f32, f32), (f32, f32, f32, f32)) {
+    let (x0, y0, w, h) = band_plot(bounds);
+    let levels_h = (h - LANE_H - LANE_GAP).max(1.0);
+    (
+        (x0, y0, w, levels_h),
+        (x0, y0 + levels_h + LANE_GAP, w, LANE_H),
+    )
+}
+
+fn level_unit(db: f32) -> f32 {
+    ((db - FLOOR_DB) / -FLOOR_DB).clamp(0.0, 1.0)
+}
+
+fn to_db(level: f32) -> f32 {
+    if level <= 1.0e-6 {
+        -120.0
+    } else {
+        20.0 * level.log10()
+    }
+}
+
+fn db_text(level: f32) -> String {
+    let db = to_db(level);
+    if db <= -119.0 {
+        "—".to_string()
+    } else if db.abs() < 0.05 {
+        "0.0".to_string()
+    } else {
+        format!("{db:.1}")
+    }
+}
+
+/// What follows the params: the frequency and level grid, the band edges,
+/// and the range — a wash over the levels where the effect applies, the lane
+/// drawn from the DSP's own weighting, and a marker at each edge that is on.
+fn paint_band_display(
+    window: &mut Window,
+    cx: &mut App,
+    bounds: Bounds<Pixels>,
+    params: &SilencerParams,
+    bypassed: bool,
+) {
+    let (plot, lane) = band_geometry(bounds);
+    let (x0, y0, w, h) = plot;
+    let ink = Colors::text_primary();
+    let faint = Colors::text_faint();
+
+    for (hz, text) in FREQ_TICKS {
+        let x = x_of(hz, plot);
+        window.paint_quad(fill(rect(x, y0, 1.0, h), Colors::with_alpha(ink, 0.045)));
+        let align = match hz {
+            20.0 => Align::Left,
+            20_000.0 => Align::Right,
+            _ => Align::Center,
+        };
+        label(
+            window,
+            cx,
+            text,
+            typography::DENSE_CAPTION,
+            faint,
+            x,
+            lane.1 + LANE_H + 3.0,
+            align,
+        );
+    }
+    for db in [-12.0, -24.0, -36.0, -48.0] {
+        let y = y0 + (1.0 - level_unit(db)) * h;
+        window.paint_quad(fill(rect(x0, y, w, 1.0), Colors::with_alpha(ink, 0.06)));
+        label(
+            window,
+            cx,
+            &format!("{db:.0}"),
+            typography::DENSE_CAPTION,
+            faint,
+            x0 + 4.0,
+            y - 12.0,
+            Align::Left,
+        );
+    }
+    // The band edges the meters split at.
+    for hz in drumsilencer::BAND_EDGES_HZ {
+        let x = x_of(hz, plot);
+        window.paint_quad(fill(
+            rect(x - 0.5, y0, 1.0, h),
+            Colors::with_alpha(ink, 0.14),
+        ));
+    }
+
+    // The range: how much of the effect applies at each frequency.
+    let accent = Colors::accent_primary();
+    let dim = if bypassed { 0.4 } else { 1.0 };
+    let column_w = w / RANGE_STEPS as f32;
+    let lane_bottom = lane.1 + LANE_H;
+    window.paint_quad(fill(rect(x0, lane.1, w, LANE_H), Colors::meter_bg()));
+    let mut curve = Vec::with_capacity(RANGE_STEPS + 1);
+    for i in 0..=RANGE_STEPS {
+        let fraction = i as f32 / RANGE_STEPS as f32;
+        let weight =
+            drumsilencer::range_weight(freq_at_fraction(fraction), params.low_hz, params.high_hz);
+        let x = x0 + fraction * w;
+        if i < RANGE_STEPS && weight > 0.01 {
+            window.paint_quad(fill(
+                rect(x, y0, column_w + 0.5, h),
+                Colors::with_alpha(accent, 0.05 * weight * dim),
+            ));
+        }
+        curve.push((x, lane_bottom - weight * LANE_H));
+    }
+    paint_area(
+        window,
+        &curve,
+        lane_bottom,
+        Colors::with_alpha(accent, 0.45 * dim),
+    );
+    paint_line(window, &curve, 1.25, Colors::with_alpha(accent, dim));
+
+    let edge = |window: &mut Window, cx: &mut App, hz: f32, text: String, align: Align| {
+        let x = x_of(hz, plot);
+        let color = Colors::with_alpha(accent, 0.85 * dim);
+        dashed(window, (x, y0), (x, lane_bottom), 1.0, color);
+        let tag_x = match align {
+            Align::Right => x - 4.0,
+            _ => x + 4.0,
+        };
+        label(
+            window,
+            cx,
+            &text,
+            typography::DENSE_CAPTION,
+            color,
+            tag_x,
+            lane.1 - LANE_GAP + 2.0,
+            align,
+        );
+    };
+    if !low_off(params.low_hz) {
+        let text = format!("Low {}", format_value(Unit::Hz, params.low_hz));
+        edge(window, cx, params.low_hz, text, Align::Left);
+    }
+    if !high_off(params.high_hz) {
+        let text = format!("High {}", format_value(Unit::Hz, params.high_hz));
+        edge(window, cx, params.high_hz, text, Align::Right);
+    }
+}
+
+/// Each band's input as a column, the drums heard in it as a narrower one
+/// inside, and the two readings over the band.
+fn paint_band_levels(
+    window: &mut Window,
+    cx: &mut App,
+    bounds: Bounds<Pixels>,
+    live: &Live,
+    bypassed: bool,
+) {
+    let Some((drums, input)) = live.slot_peaks() else {
+        return;
+    };
+    let (plot, _) = band_geometry(bounds);
+    let (_, y0, _, h) = plot;
+    let bottom = y0 + h;
+    let edges = band_edges();
+    let muted = Colors::text_muted();
+    let accent = Colors::accent_primary();
+    let y_of = |level: f32| y0 + (1.0 - level_unit(to_db(level))) * h;
+    for band in 0..drumsilencer::BANDS {
+        let left = x_of(edges[band], plot) + 2.0;
+        let right = x_of(edges[band + 1], plot) - 2.0;
+        let width = right - left;
+        if width < 4.0 {
+            continue;
+        }
+        let top = y_of(input[band]);
+        if bottom - top > 0.5 {
+            window.paint_quad(fill(
+                rect(left, top, width, bottom - top),
+                Colors::with_alpha(muted, 0.22),
+            ));
+            window.paint_quad(fill(
+                rect(left, top, width, 1.5),
+                Colors::with_alpha(muted, 0.8),
+            ));
+        }
+        let heard = if bypassed { 0.0 } else { drums[band] };
+        let top = y_of(heard);
+        let inset = width * 0.22;
+        if bottom - top > 0.5 {
+            window.paint_quad(fill(
+                rect(left + inset, top, width - 2.0 * inset, bottom - top),
+                Colors::with_alpha(accent, 0.7),
+            ));
+            window.paint_quad(fill(
+                rect(left + inset, top, width - 2.0 * inset, 1.5),
+                accent,
+            ));
+        }
+        if width > 60.0 {
+            let centre = (left + right) * 0.5;
+            label(
+                window,
+                cx,
+                BAND_NAMES[band],
+                typography::DENSE_CAPTION,
+                Colors::text_secondary(),
+                centre,
+                y0 + 2.0,
+                Align::Center,
+            );
+            label(
+                window,
+                cx,
+                &format!("in {}", db_text(input[band])),
+                typography::DENSE_CAPTION,
+                muted,
+                centre,
+                y0 + 15.0,
+                Align::Center,
+            );
+            label(
+                window,
+                cx,
+                &format!("drums {}", db_text(heard)),
+                typography::DENSE_CAPTION,
+                Colors::accent_primary_hover(),
+                centre,
+                y0 + 28.0,
+                Align::Center,
+            );
+        }
+    }
+}
+
+// ── Meters ──────────────────────────────────────────────────────────────────
+
+/// In, Drums and Out as RMS bars over [`FLOOR_DB`] to 0 dBFS — In and Out
+/// with their peak as a tick — and the latency the host reports under them.
+fn paint_silencer_meters(window: &mut Window, cx: &mut App, bounds: Bounds<Pixels>, live: &Live) {
+    const CAPTION_H: f32 = 16.0;
+    const READOUT_H: f32 = 18.0;
+    const FOOT_H: f32 = 30.0;
+    const BAR_W: f32 = 12.0;
+    let (x0, y0, w, h) = frame_of(bounds);
+    let frame = live.frame;
+    let foot_top = y0 + h - FOOT_H;
+    let bar_top = y0 + CAPTION_H;
+    let bar_h = (foot_top - READOUT_H - space::BASE - bar_top).max(1.0);
+    let column_w = w / 3.0;
+    // `(caption, rms, peak)`; `None` until the host publishes a frame.
+    let columns: [(&str, Option<f32>, Option<f32>); 3] = [
+        ("In", frame.map(|f| f.in_rms), frame.map(|f| f.in_peak)),
+        (
+            "Drums",
+            frame.map(|f| drums_level(&f.slot_in_peak[..drumsilencer::BANDS])),
+            None,
+        ),
+        ("Out", frame.map(|f| f.out_rms), frame.map(|f| f.out_peak)),
+    ];
+    for (i, (caption, rms, peak)) in columns.into_iter().enumerate() {
+        let centre = x0 + column_w * (i as f32 + 0.5);
+        let drums = i == 1;
+        label(
+            window,
+            cx,
+            caption,
+            typography::DENSE_CAPTION,
+            Colors::text_muted(),
+            centre,
+            y0,
+            Align::Center,
+        );
+        let x = centre - BAR_W * 0.5;
+        window.paint_quad(fill(rect(x, bar_top, BAR_W, bar_h), Colors::meter_bg()));
+        if let Some(rms) = rms {
+            let fill_top = bar_top + (1.0 - level_unit(to_db(rms))) * bar_h;
+            let color = if peak.is_some_and(|peak| peak >= 1.0) {
+                Colors::meter_high()
+            } else if drums {
+                Colors::accent_primary()
+            } else {
+                Colors::text_muted()
+            };
+            window.paint_quad(fill(
+                rect(x, fill_top, BAR_W, bar_top + bar_h - fill_top),
+                color,
+            ));
+        }
+        if let Some(peak) = peak {
+            let unit = level_unit(to_db(peak));
+            if unit > 0.0 {
+                window.paint_quad(fill(
+                    rect(x, bar_top + (1.0 - unit) * bar_h, BAR_W, 1.5),
+                    Colors::text_primary(),
+                ));
+            }
+        }
+        label(
+            window,
+            cx,
+            &rms.map_or_else(|| "—".to_string(), db_text),
+            typography::UI_XS,
+            Colors::text_secondary(),
+            centre,
+            bar_top + bar_h + 3.0,
+            Align::Center,
+        );
+    }
+
+    window.paint_quad(fill(rect(x0, foot_top, w, 1.0), Colors::border_subtle()));
+    label(
+        window,
+        cx,
+        "Latency",
+        typography::DENSE_CAPTION,
+        Colors::text_muted(),
+        x0,
+        foot_top + 9.0,
+        Align::Left,
+    );
+    label(
+        window,
+        cx,
+        &latency_text(live.latency_ms()),
+        typography::UI_XS,
+        Colors::text_secondary(),
+        x0 + w,
+        foot_top + 8.0,
+        Align::Right,
+    );
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_subtitle_names_the_mode() {
+        let params = drumsilencer::default_params();
+        assert_eq!(DrumSilencerModel.subtitle(&params), "Removes the drums");
+        let solo = drum_silencer_model::with(&params, "mode", 1.0);
+        assert_eq!(DrumSilencerModel.subtitle(&solo), "Keeps only the drums");
+    }
+
+    #[test]
+    fn levels_place_on_the_display_floor() {
+        assert_eq!(level_unit(0.0), 1.0);
+        assert_eq!(level_unit(FLOOR_DB), 0.0);
+        assert_eq!(level_unit(-120.0), 0.0);
+        assert_eq!(db_text(0.0), "—");
+        assert_eq!(db_text(1.0), "0.0");
+        assert_eq!(db_text(0.1), "-20.0");
+    }
+}
