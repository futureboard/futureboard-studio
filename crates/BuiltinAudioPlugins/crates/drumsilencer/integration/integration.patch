+        restored.process_block(&input, &input, &mut output, input.len());
+        for i in 0..input.len() {
+            let expected = if i < 255 { 0.0 } else { input[i - 255] };
+            assert!(
+                (output[i * 2] - expected).abs() < 1.0e-5,
+                "restored power-off must be a pure delay at {i}"
+            );
+        }
+        let frame = restored.meter_frame().expect("frame is published");
+        assert!(frame.slot_in_peak.iter().all(|level| *level == 0.0));
+        assert!(frame.slot_out_peak.iter().any(|level| *level > 0.0));
+
+        restored.apply_param(u32::MAX, 1.0);
+        restored.apply_param(drumsilencer::UI_PARAM_IDS.len() as u32, 1.0);
+        let power = drumsilencer::ui_param_index("power").expect("in wire table");
+        restored.apply_param(power, 1.0);
+        restored.process_block(&input, &input, &mut output, input.len());
+        assert!(output.iter().all(|sample| sample.is_finite()));
+
+        let fallback = BuiltinHostProcessor::drumsilencer(48_000, Some("not json"));
+        fallback.process_block(&input, &input, &mut output, input.len());
+        assert!(output.iter().all(|sample| sample.is_finite()));
+    }
 }
 
