# Solfege Voxtune (Android) settings. Copy to `.env` next to this file and
# fill it in; `.env` is never committed. Gradle reads it at build time and
# scripts/play-upload.mjs reads it when uploading.

# ── Purchase check (Google Play licensing) ─────────────────────────────
# Play Console → Monetize with Play → Monetization setup → Licensing: the
# app's Base64-encoded RSA public key, on one line. It verifies Google Play's
# signed answer to "did this user buy the app?". Empty turns the check off
# (debug and sideloaded test builds).
PLAY_LICENSE_PUBLIC_KEY=
# true: the build skips the purchase check. For internal / closed (alpha)
# testing while the app has no price on Play yet, when Play cannot answer
# "bought". Set false for a production release: scripts/play-upload.mjs
# refuses to send a bypassed build to the production track.
PLAY_LICENSE_BYPASS=true

# ── Build uploads (Google Play Developer API) ──────────────────────────
# Path to a Google Cloud service account's JSON key. The account needs the
# Google Play Android Developer API enabled in its Cloud project, and must
# be invited in Play Console → Users and permissions with release rights for
# this app.
PLAY_SERVICE_ACCOUNT_JSON=
PLAY_PACKAGE_NAME=studio.futureboard.voxtune
# internal | alpha (closed testing) | beta (open testing) | production
PLAY_TRACK=internal
# draft | completed. Must stay `draft` until the app has been published once.
PLAY_RELEASE_STATUS=draft
