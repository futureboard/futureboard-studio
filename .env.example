# ------------------------------------------------------------------------------
# Futureboard Studio — development configuration
# ------------------------------------------------------------------------------
#
# Copy to `.env` and edit. `.env` is git-ignored; this file is the template and
# must never carry a real value.
#
#   cp .env.example .env
#
# WHAT BELONGS HERE
#   Public endpoints and switches only. Nothing in this file is a credential.
#
# WHAT MUST NEVER BE PUT HERE
#   API secrets, JWT signing keys, database credentials, private keys, invite
#   master secrets, server auth secrets. The Studio client holds none of them:
#   it authenticates with the Futureboard account session the app already has,
#   and every other credential it uses is short-lived and issued at runtime.
#
# A RELEASE BUILD DOES NOT READ THIS FILE.
#   Production endpoints are compiled in and may be overridden by the process
#   environment. A shipped binary with no environment at all points at the
#   public service.

# ------------------------------------------------------------------------------
# Futureboard account service
# ------------------------------------------------------------------------------
#
# Baked at build time by `crates/SphereUIComponents/build.rs`. Without it, the
# build reports "account service not configured" and disables sign-in rather
# than guessing a host.
AUTH_API_URL=https://futureboard.studio

# ------------------------------------------------------------------------------
# Audio Jam
# ------------------------------------------------------------------------------
#
# `development` additionally allows plaintext endpoints on loopback. Any other
# value is treated as production, where https/wss are required.
FUTUREBOARD_ENV=development

# Jam REST control plane. When only this is set, the signaling url is derived
# from it (http -> ws, https -> wss, path /v1/realtime), which is the commonest
# way the two halves end up pointed at different processes.
FUTUREBOARD_JAM_API_URL=http://127.0.0.1:8090

# Jam realtime signaling. Optional when the line above is set.
FUTUREBOARD_JAM_WS_URL=ws://127.0.0.1:8090/v1/realtime

# The browser-facing origin that serves jam links (the React guest/listener UI).
FUTUREBOARD_JAM_WEB_URL=http://127.0.0.1:5173

# auto | th-bkk | th-ptn | sg-sin | id-jkt
# `auto` lets the server's own selector choose. An unrecognised value is an
# error at startup rather than a silent fall back to `auto`.
FUTUREBOARD_JAM_REGION=auto

# Networking.
FUTUREBOARD_JAM_CONNECT_TIMEOUT_MS=10000
FUTUREBOARD_JAM_RECONNECT=true
FUTUREBOARD_JAM_RECONNECT_MAX_DELAY_MS=10000

# error | warn | info | debug | trace — jam subsystem only.
FUTUREBOARD_JAM_LOG_LEVEL=debug

# A development-only account token, for a local `jamd` started with
# `JAM_AUTH_MODE=dev`, which cannot validate a real Futureboard session. The
# server accepts `dev:<name>` as that account.
#
# It is read ONLY by a debug build with FUTUREBOARD_ENV=development, and there
# is no code path in a release binary that reads it at all. Never commit a real
# token here.
#FUTUREBOARD_JAM_DEV_TOKEN=dev:hachi224

# ------------------------------------------------------------------------------
# TONE3000 (Rodhareist NAM A2 catalog)
# ------------------------------------------------------------------------------
#
# Native-only partner Bearer key (`t3k_cs_…`). Baked at build time by
# `crates/SphereUIComponents/build.rs` into the Studio binary; the CEF editor
# never sees it. A process `FUTUREBOARD_TONE3000_API_KEY` / `TONE3000_API_KEY`
# still overrides the baked value at runtime.
#
# Put the real secret in `.env`, not in this template.
#FUTUREBOARD_TONE3000_API_KEY=
