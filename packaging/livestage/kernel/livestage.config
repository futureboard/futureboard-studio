# LiveStage's changes to Alpine's linux-lts configuration
# (config-alpine-*), merged by build-kernel.sh before `make olddefconfig`.

CONFIG_LOCALVERSION="-livestage"
# Full preemption by default: the audio threads (SCHED_FIFO) get the CPU
# back sooner. `preempt=voluntary` on the command line undoes it.
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT=y
# No debug info or BTF: the appliance has no debugger or BPF tooling, and
# the build takes a fraction of the time.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# Modules are signed with a key made for each build (Alpine's own key is
# theirs); unsigned modules still load, as on Alpine.
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
