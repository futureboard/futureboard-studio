#!/sbin/openrc-run
# LiveStage: the headless mixer and its web UI.
#
# Settings: /etc/conf.d/livestage, then what the console's setup saved
# (/var/lib/livestage/setup.conf), then /var/lib/livestage/livestage.conf,
# which wins. All three are root's: the root filesystem is read-only, and the
# settings partition is not writable by the service account. (The data
# partition is exFAT and is the service's: nothing on it is read as root.)

name="LiveStage"
description="LiveStage live mixer and its web UI"

[ -r /var/lib/livestage/setup.conf ] && . /var/lib/livestage/setup.conf
[ -r /var/lib/livestage/livestage.conf ] && . /var/lib/livestage/livestage.conf

: "${LIVESTAGE_SESSION:=/data/livestage/show.json}"
: "${LIVESTAGE_HTTP:=0.0.0.0:8730}"

# The interface the setup picked, for the very first start only: from then on
# the session holds it, and the web UI (or the setup) changes it there.
first_audio=""
if [ ! -e "${LIVESTAGE_SESSION}" ]; then
	[ -n "${AUDIO_OUTPUT}" ] && first_audio="${first_audio} --output ${AUDIO_OUTPUT}"
	[ -n "${AUDIO_INPUT}" ] && first_audio="${first_audio} --input ${AUDIO_INPUT}"
	[ "${AUDIO_RATE:-0}" != 0 ] && first_audio="${first_audio} --rate ${AUDIO_RATE}"
	[ -n "${AUDIO_BUFFER}" ] && first_audio="${first_audio} --buffer ${AUDIO_BUFFER}"
fi

supervisor="supervise-daemon"
command="/usr/bin/livestage-server"
command_user="livestage:audio"
directory="/data/livestage"
output_log="/var/log/livestage.log"
error_log="/var/log/livestage.log"
# A crash in the middle of a show restarts the mixer, again and again.
respawn_delay=2
respawn_max=0
# SIGTERM closes the take being recorded and saves the session.
retry="TERM/15/KILL/5"
# The audio threads ask for real-time priority (SCHED_FIFO 70), so the web
# server, a browser or a disk write cannot hold them past their period: the
# service account may use up to 70.
rc_ulimit="-r 70"

depend() {
	need localmount
	use net mdev hwdrivers livestage-storage
	after livestage-data livestage-config livestage-storage avahi-daemon
}

start_pre() {
	# Where recordings go: the storage the setup chose (a USB drive, mounted
	# now if it is plugged in), else the data partition. LIVESTAGE_RECORDINGS
	# in livestage.conf overrides it. The running server follows later
	# changes itself.
	if [ -z "${LIVESTAGE_RECORDINGS}" ]; then
		LIVESTAGE_RECORDINGS=$(/usr/bin/livestage-setup --storage-path 2>/dev/null) ||
			LIVESTAGE_RECORDINGS=/data/livestage/recordings
	fi
	# exFAT: the folders are the service's by the mount's options, not by
	# chown.
	mkdir -p /data/livestage "${LIVESTAGE_RECORDINGS}" &&
		checkpath -f -m 0640 -o livestage:audio /var/log/livestage.log || return 1
	# OpenRC evals command_args: the quotes keep a folder with spaces in it
	# ("LiveStage Recordings") one argument.
	command_args="--session \"${LIVESTAGE_SESSION}\" --record-dir \"${LIVESTAGE_RECORDINGS}\" --http ${LIVESTAGE_HTTP} --daemon${first_audio} ${LIVESTAGE_ARGS}"
}
