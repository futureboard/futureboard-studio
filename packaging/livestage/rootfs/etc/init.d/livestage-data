#!/sbin/openrc-run
# The image is small; the disk it is written to usually is not. On the first
# boot from a bigger disk, give the data partition (the last one) the rest of
# the disk, so recordings get all of it. exFAT cannot grow in place: the
# partition is made anew, which is only done while it is still empty, as the
# image left it. Does nothing once the partition reaches the end of the disk.

description="Give the LiveStage data partition the whole disk"

depend() {
	need root
	after modules
	before localmount
}

# Whether the exFAT filesystem on $1 holds nothing at all.
is_empty() {
	local dir=/run/livestage-data.check empty=1
	mkdir -p "$dir" || return 1
	if mount -t exfat -o ro "$1" "$dir" 2>/dev/null; then
		[ -z "$(ls -A "$dir")" ] || empty=0
		umount "$dir"
	else
		empty=0
	fi
	rmdir "$dir"
	[ $empty = 1 ]
}

start() {
	local part name num disk dname disk_size start size free
	part=$(findfs LABEL=lsdata 2>/dev/null) || {
		ewarn "No data partition (LABEL=lsdata)"
		return 0
	}
	name=${part#/dev/}
	num=$(cat "/sys/class/block/$name/partition" 2>/dev/null) || return 0
	dname=$(basename "$(readlink -f "/sys/class/block/$name/..")")
	disk="/dev/$dname"
	disk_size=$(cat "/sys/class/block/$dname/size")
	start=$(cat "/sys/class/block/$name/start")
	size=$(cat "/sys/class/block/$name/size")
	# Sectors past the partition, less the 33 the backup GPT keeps at the end.
	free=$((disk_size - start - size - 33))
	[ "$free" -gt 32768 ] || return 0

	modprobe -q exfat 2>/dev/null
	if ! is_empty "$part"; then
		ewarn "The data partition has files on it: it keeps its size ($((size / 2048)) MiB)"
		return 0
	fi

	ebegin "Giving the data partition the rest of $disk"
	# The image's backup GPT sits where the image ended; move it to the real
	# end of the disk first, then extend the last partition into the space.
	sfdisk --force --no-reread --no-tell-kernel --relocate gpt-bak-std "$disk" >/dev/null 2>&1 &&
		echo ", +" | sfdisk --force --no-reread --no-tell-kernel -N "$num" "$disk" >/dev/null 2>&1 &&
		partx -u -n "$num" "$disk" || {
		eend 1 "Could not grow the partition on $disk"
		return 0
	}
	# partx re-adds the partition to the kernel, which drops its device node;
	# this early in boot nothing makes it again unless asked.
	mdev -s 2>/dev/null
	local tries=0
	while [ ! -b "$part" ] && [ $tries -lt 20 ]; do
		sleep 0.1
		tries=$((tries + 1))
	done
	mkfs.exfat -L lsdata "$part" >/dev/null 2>&1
	eend $? "Could not make the filesystem on $part"
}
