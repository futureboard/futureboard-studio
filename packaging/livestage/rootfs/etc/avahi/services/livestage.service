<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Announces the web UI, so browsers and apps find http://livestage.local:8730/ -->
<service-group>
  <name replace-wildcards="yes">LiveStage on %h</name>
  <service>
    <type>_http._tcp</type>
    <port>8730</port>
    <txt-record>path=/</txt-record>
  </service>
</service-group>
