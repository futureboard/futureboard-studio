#!/bin/sh
# The LiveStage installer ISO's initramfs init (mkinitfs -i): finds the
# medium the ISO was written to or is in (a USB stick, a CD, a BMC's virtual
# media) by its ISO 9660 volume label, mounts the installer's system from it
# (livestage/installer.sfs, read-only) under a tmpfs, and starts it.
#
# The medium is looked for on every block device, partitions and sr* too,
# so it does not matter whether the firmware booted it as a disk (hybrid
# GPT) or as a CD (El Torito): the root lives in the ISO 9660 filesystem
# either way. Kernel options: livestage.label=LABEL (LSINSTALL),
# livestage.wait=SECONDS (15, for slow USB), livestage.debug (a shell before
# switching root).

/bin/busybox mkdir -p /usr/bin /usr/sbin /proc /sys /dev /tmp /run \
	/media/medium /media/lower /media/rw /sysroot
/bin/busybox --install -s
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

mount -t proc -o noexec,nosuid,nodev proc /proc
mount -t sysfs -o noexec,nosuid,nodev sysfs /sys
mount -t devtmpfs -o exec,nosuid,mode=0755,size=2M devtmpfs /dev 2>/dev/null ||
	mount -t tmpfs -o exec,nosuid,mode=0755,size=2M tmpfs /dev
[ -c /dev/null ] || mknod -m 666 /dev/null c 1 3
echo /sbin/mdev >/proc/sys/kernel/hotplug 2>/dev/null

label=LSINSTALL
wait=15
debug=
for option in $(cat /proc/cmdline); do
	case "$option" in
	livestage.label=*) label=${option#*=} ;;
	livestage.wait=*) wait=${option#*=} ;;
	livestage.debug) debug=1 ;;
	esac
done

say() { echo "livestage: $*"; }

# A shell on the console; init goes on when it ends.
rescue() {
	echo
	say "$*"
	say "A shell follows; 'exit' tries again."
	# On the screen's console, as its controlling terminal (Ctrl+C works).
	if [ -c /dev/tty1 ]; then
		setsid sh -c 'exec sh </dev/tty1 >/dev/tty1 2>&1'
	else
		sh
	fi
}

# Drivers for whatever is there (storage controllers, USB, the keyboard),
# then for what they found in turn (a USB disk behind its hub), and the
# filesystems the medium needs.
coldplug() {
	find /sys/devices -name modalias -type f 2>/dev/null | xargs cat 2>/dev/null |
		sort -u | xargs modprobe -a -q 2>/dev/null
	modprobe -a -q sr_mod sd_mod usb-storage uas isofs squashfs overlay loop 2>/dev/null
	mdev -s 2>/dev/null
}

# The volume label of an ISO 9660 filesystem on $1 (bytes 40-71 of its
# primary volume descriptor, at 32 KiB), or nothing.
iso_label() {
	[ "$(dd if="$1" bs=1 skip=32769 count=5 2>/dev/null)" = CD001 ] || return 1
	dd if="$1" bs=1 skip=32808 count=32 2>/dev/null | sed 's/ *$//'
}

# Mounts the medium at /media/medium: the first block device whose ISO 9660
# label is $label and which holds the installer's system.
find_medium() {
	local name dev
	for name in $(ls /sys/class/block); do
		case "$name" in loop* | ram* | zram*) continue ;; esac
		dev=/dev/$name
		[ -b "$dev" ] || continue
		[ "$(iso_label "$dev")" = "$label" ] || continue
		if mount -t iso9660 -o ro "$dev" /media/medium 2>/dev/null; then
			if [ -f /media/medium/livestage/installer.sfs ]; then
				say "the installer is on $dev"
				return 0
			fi
			umount /media/medium
		fi
	done
	return 1
}

say "looking for the installer's medium (label $label)"
while :; do
	tries=$((wait * 2))
	found=
	while [ "$tries" -gt 0 ]; do
		coldplug
		if find_medium; then
			found=1
			break
		fi
		sleep 0.5
		tries=$((tries - 1))
	done
	[ -n "$found" ] && break
	rescue "The installer's medium (an ISO 9660 volume labelled $label, holding
livestage/installer.sfs) was not found within $wait s. Disks and drives seen:
$(ls /sys/class/block | grep -vE '^(loop|ram|zram)' | tr '\n' ' ')
Write the .iso to the stick as a raw image (Rufus in DD mode, balenaEtcher,
dd), or check that the virtual CD is attached."
done

until mount -t squashfs -o ro,loop /media/medium/livestage/installer.sfs /media/lower; do
	rescue "Could not mount livestage/installer.sfs from the medium (damaged?)."
done
# Changes made while it runs live in memory and are gone at the next boot.
mount -t tmpfs -o mode=0755,size=50% tmpfs /media/rw
mkdir -p /media/rw/upper /media/rw/work
until mount -t overlay -o lowerdir=/media/lower,upperdir=/media/rw/upper,workdir=/media/rw/work \
	overlay /sysroot; do
	rescue "Could not mount the system's overlay."
done

# The installer reads the image to install from the medium, and finds the
# disk it must not install onto from it: both stay where it looks.
for dir in medium lower rw; do
	mkdir -p /sysroot/media/$dir
	mount --move /media/$dir /sysroot/media/$dir
done
[ -n "$debug" ] && rescue "livestage.debug: about to start the system from /sysroot."
echo "" >/proc/sys/kernel/hotplug 2>/dev/null
mount --move /dev /sysroot/dev
umount /sys /proc
exec switch_root /sysroot /sbin/init
