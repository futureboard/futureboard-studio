# The LiveStage installer: its system is the ISO's livestage/installer.sfs
# under a tmpfs overlay, put together by the initramfs (no entry for / here);
# the medium itself is mounted read-only at /media/medium. It mounts nothing
# of the disk it installs onto but for a moment (the settings), by that
# disk's own partition numbers.
tmpfs		/tmp		tmpfs	nosuid,nodev,mode=1777		0 0
tmpfs		/var/tmp	tmpfs	nosuid,nodev,mode=1777		0 0
tmpfs		/var/log	tmpfs	nosuid,nodev,mode=0755		0 0
